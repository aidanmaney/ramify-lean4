{
  "name": "ramify-renderer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Ramify's React/d3-dag proof-tree renderer: the standalone dev harness and the infoview widget bundle, from one source-agnostic view.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:widget": "node build-widget.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@leanprover/unicode-input": "^0.1.11",
    "d3-dag": "^1.2.1",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@leanprover/infoview": "^0.8.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.12"
  }
}
